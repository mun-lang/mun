---
source: crates/mun_codegen/src/test.rs
expression: "\n    pub struct(gc) GcStruct(f32, f32);\n    pub struct(value) ValueStruct(f32, f32);\n\n    pub struct(gc) GcWrapper(GcStruct, ValueStruct)\n    pub struct(value) ValueWrapper(GcStruct, ValueStruct);\n\n    pub fn new_gc_struct(a: f32, b: f32) -> GcStruct {\n        GcStruct(a, b)\n    }\n\n    pub fn new_value_struct(a: f32, b: f32) -> ValueStruct {\n        ValueStruct(a, b)\n    }\n\n    pub fn new_gc_wrapper(a: GcStruct, b: ValueStruct) -> GcWrapper {\n        GcWrapper(a, b)\n    }\n\n    pub fn new_value_wrapper(a: GcStruct, b: ValueStruct) -> ValueWrapper {\n        ValueWrapper(a, b)\n    }\n    "
---
; == FILE IR (mod) =====================================
; ModuleID = 'mod'
source_filename = "mod"

%DispatchTable = type { ptr }
%GcStruct = type { float, float }
%ValueStruct = type { float, float }
%GcWrapper = type { ptr, %ValueStruct }
%ValueWrapper = type { ptr, %ValueStruct }

@allocatorHandle = external global ptr
@dispatchTable = external global %DispatchTable
@global_type_lookup_table = external global [5 x ptr]

define ptr @new_gc_struct(float %0, float %1) {
body:
  %b = alloca float, align 4
  store float %1, ptr %b, align 4
  %a = alloca float, align 4
  store float %0, ptr %a, align 4
  %a1 = load float, ptr %a, align 4
  %b2 = load float, ptr %b, align 4
  %init = insertvalue %GcStruct undef, float %a1, 0
  %init3 = insertvalue %GcStruct %init, float %b2, 1
  %new_ptr = load ptr, ptr @dispatchTable, align 8
  %GcStruct_ptr = load ptr, ptr @global_type_lookup_table, align 8
  %allocator_handle = load ptr, ptr @allocatorHandle, align 8
  %ref = call ptr %new_ptr(ptr %GcStruct_ptr, ptr %allocator_handle)
  %"ref->data" = load ptr, ptr %ref, align 8
  store %GcStruct %init3, ptr %"ref->data", align 4
  ret ptr %ref
}

define %ValueStruct @new_value_struct(float %0, float %1) {
body:
  %b = alloca float, align 4
  store float %1, ptr %b, align 4
  %a = alloca float, align 4
  store float %0, ptr %a, align 4
  %a1 = load float, ptr %a, align 4
  %b2 = load float, ptr %b, align 4
  %init = insertvalue %ValueStruct undef, float %a1, 0
  %init3 = insertvalue %ValueStruct %init, float %b2, 1
  ret %ValueStruct %init3
}

define ptr @new_value_struct_wrapper(float %0, float %1) {
body:
  %new_value_struct = call %ValueStruct @new_value_struct(float %0, float %1)
  %new_ptr = load ptr, ptr @dispatchTable, align 8
  %ValueStruct_ptr = load ptr, ptr getelementptr ([5 x ptr], ptr @global_type_lookup_table, i64 0, i64 2), align 8
  %allocator_handle = load ptr, ptr @allocatorHandle, align 8
  %ref = call ptr %new_ptr(ptr %ValueStruct_ptr, ptr %allocator_handle)
  %"ref->data" = load ptr, ptr %ref, align 8
  store %ValueStruct %new_value_struct, ptr %"ref->data", align 4
  ret ptr %ref
}

define ptr @new_gc_wrapper(ptr %0, %ValueStruct %1) {
body:
  %b = alloca %ValueStruct, align 8
  store %ValueStruct %1, ptr %b, align 4
  %a = alloca ptr, align 8
  store ptr %0, ptr %a, align 8
  %a1 = load ptr, ptr %a, align 8
  %b2 = load %ValueStruct, ptr %b, align 4
  %init = insertvalue %GcWrapper undef, ptr %a1, 0
  %init3 = insertvalue %GcWrapper %init, %ValueStruct %b2, 1
  %new_ptr = load ptr, ptr @dispatchTable, align 8
  %GcWrapper_ptr = load ptr, ptr getelementptr ([5 x ptr], ptr @global_type_lookup_table, i64 0, i64 1), align 8
  %allocator_handle = load ptr, ptr @allocatorHandle, align 8
  %ref = call ptr %new_ptr(ptr %GcWrapper_ptr, ptr %allocator_handle)
  %"ref->data" = load ptr, ptr %ref, align 8
  store %GcWrapper %init3, ptr %"ref->data", align 8
  ret ptr %ref
}

define ptr @new_gc_wrapper_wrapper(ptr %0, ptr %1) {
body:
  %"->data" = load ptr, ptr %1, align 8
  %deref = load %ValueStruct, ptr %"->data", align 4
  %new_gc_wrapper = call ptr @new_gc_wrapper(ptr %0, %ValueStruct %deref)
  ret ptr %new_gc_wrapper
}

define %ValueWrapper @new_value_wrapper(ptr %0, %ValueStruct %1) {
body:
  %b = alloca %ValueStruct, align 8
  store %ValueStruct %1, ptr %b, align 4
  %a = alloca ptr, align 8
  store ptr %0, ptr %a, align 8
  %a1 = load ptr, ptr %a, align 8
  %b2 = load %ValueStruct, ptr %b, align 4
  %init = insertvalue %ValueWrapper undef, ptr %a1, 0
  %init3 = insertvalue %ValueWrapper %init, %ValueStruct %b2, 1
  ret %ValueWrapper %init3
}

define ptr @new_value_wrapper_wrapper(ptr %0, ptr %1) {
body:
  %"->data" = load ptr, ptr %1, align 8
  %deref = load %ValueStruct, ptr %"->data", align 4
  %new_value_wrapper = call %ValueWrapper @new_value_wrapper(ptr %0, %ValueStruct %deref)
  %new_ptr = load ptr, ptr @dispatchTable, align 8
  %ValueWrapper_ptr = load ptr, ptr getelementptr ([5 x ptr], ptr @global_type_lookup_table, i64 0, i64 3), align 8
  %allocator_handle = load ptr, ptr @allocatorHandle, align 8
  %ref = call ptr %new_ptr(ptr %ValueWrapper_ptr, ptr %allocator_handle)
  %"ref->data" = load ptr, ptr %ref, align 8
  store %ValueWrapper %new_value_wrapper, ptr %"ref->data", align 8
  ret ptr %ref
}

; == GROUP IR (mod) ====================================
; ModuleID = 'group_name'
source_filename = "group_name"

%DispatchTable = type { ptr }

@dispatchTable = global %DispatchTable zeroinitializer
@global_type_lookup_table = global [5 x ptr] zeroinitializer
@allocatorHandle = unnamed_addr global ptr null
