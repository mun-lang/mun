  store i8 %0, ptr %a, align 1
  %a1 = load i8, ptr %a, align 1
  %b2 = load i8, ptr %b, align 1
  %lesseq = icmp ule i8 %a1, %b2
  ret i1 %lesseq
}

define i1 @greater(i8 %0, i8 %1) {
body:
  %b = alloca i8, align 1
  store i8 %1, ptr %b, align 1
  %a = alloca i8, align 1
  store i8 %0, ptr %a, align 1
  %a1 = load i8, ptr %a, align 1
  %b2 = load i8, ptr %b, align 1
  %greater = icmp ugt i8 %a1, %b2
  ret i1 %greater
}

define i1 @greater_equal(i8 %0, i8 %1) {
body:
