@global_type_lookup_table = external global [1 x ptr]

define i128 @add(i128 %0, i128 %1) {
body:
  %b = alloca i128, align 8
  store i128 %1, ptr %b, align 4
  %a = alloca i128, align 8
  store i128 %0, ptr %a, align 4
  %a1 = load i128, ptr %a, align 4
  %b2 = load i128, ptr %b, align 4
  %add = add i128 %a1, %b2
  ret i128 %add
}

