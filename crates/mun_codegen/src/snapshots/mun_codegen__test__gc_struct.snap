---
source: crates/mun_codegen/src/test.rs
expression: "\n    struct(gc) Foo { a: i32, b: i32 };\n\n    pub fn foo() {\n        let a = Foo { a: 3, b: 4 };\n        a.b += 3;\n        let b = a;\n    }\n    "
---
; == FILE IR (mod) =====================================
; ModuleID = 'mod'
source_filename = "mod"

%DispatchTable = type { ptr }
%Foo = type { i32, i32 }

@allocatorHandle = external global ptr
@dispatchTable = external global %DispatchTable
@global_type_lookup_table = external global [2 x ptr]

define void @foo() {
body:
  %b = alloca ptr, align 8
  %a = alloca ptr, align 8
  %new_ptr = load ptr, ptr @dispatchTable, align 8
  %Foo_ptr = load ptr, ptr @global_type_lookup_table, align 8
  %allocator_handle = load ptr, ptr @allocatorHandle, align 8
  %ref = call ptr %new_ptr(ptr %Foo_ptr, ptr %allocator_handle)
  %"ref->data" = load ptr, ptr %ref, align 8
  store %Foo { i32 3, i32 4 }, ptr %"ref->data", align 4
  store ptr %ref, ptr %a, align 8
  %"a->data" = load ptr, ptr %a, align 8
  %deref = load ptr, ptr %"a->data", align 8
  %"Foo->b" = getelementptr inbounds nuw %Foo, ptr %deref, i32 0, i32 1
  %Foo.b = load i32, ptr %"Foo->b", align 4
  %add = add i32 %Foo.b, 3
  %"a->data1" = load ptr, ptr %a, align 8
  %deref2 = load ptr, ptr %"a->data1", align 8
  %"Foo->b3" = getelementptr inbounds nuw %Foo, ptr %deref2, i32 0, i32 1
  store i32 %add, ptr %"Foo->b3", align 4
  %a4 = load ptr, ptr %a, align 8
  store ptr %a4, ptr %b, align 8
  ret void
}

; == GROUP IR (mod) ====================================
; ModuleID = 'group_name'
source_filename = "group_name"

%DispatchTable = type { ptr }

@dispatchTable = global %DispatchTable zeroinitializer
@global_type_lookup_table = global [2 x ptr] zeroinitializer
@allocatorHandle = unnamed_addr global ptr null
