  %a3 = load i8, ptr %a, align 1
  ret i8 %a3
}

define i8 @assign_bitor(i8 %0, i8 %1) {
body:
  %b = alloca i8, align 1
  store i8 %1, ptr %b, align 1
  %a = alloca i8, align 1
  store i8 %0, ptr %a, align 1
