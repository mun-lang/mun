  %ref = call ptr %new_array_ptr(ptr %"[core::i8]_ptr", i64 4, ptr %allocator_handle)
  %"ref->data" = load ptr, ptr %ref, align 8
  %"ref->data->elements" = getelementptr inbounds %"[i8]", ptr %"ref->data", i32 0, i32 2
  %"ref->data->elements[0]" = getelementptr i8, ptr %"ref->data->elements", i64 0
  store i8 1, ptr %"ref->data->elements[0]", align 1
  %"ref->data->elements[1]" = getelementptr i8, ptr %"ref->data->elements", i64 1
  store i8 2, ptr %"ref->data->elements[1]", align 1
  %"ref->data->elements[2]" = getelementptr i8, ptr %"ref->data->elements", i64 2
  store i8 3, ptr %"ref->data->elements[2]", align 1
  %"ref->data->elements[3]" = getelementptr i8, ptr %"ref->data->elements", i64 3
  store i8 4, ptr %"ref->data->elements[3]", align 1
  %"ref->data1" = load ptr, ptr %ref, align 8
  %"ref->data1->length" = getelementptr inbounds %"[i8]", ptr %"ref->data1", i32 0, i32 0
  store i64 4, ptr %"ref->data1->length", align 4
  store ptr %ref, ptr %a, align 8
  %a2 = load ptr, ptr %a, align 8
  %"a2->data" = load ptr, ptr %a2, align 8
  %"a2->data->elements" = getelementptr inbounds %"[i8]", ptr %"a2->data", i32 0, i32 2
  %"a2->data->elements+index" = getelementptr i8, ptr %"a2->data->elements", i32 3
  %0 = load i8, ptr %"a2->data->elements+index", align 1
  ret i8 %0
}

