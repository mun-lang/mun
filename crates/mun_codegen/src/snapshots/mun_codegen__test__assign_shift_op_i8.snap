}

define i8 @assign_rightshift(i8 %0, i8 %1) {
body:
  %b = alloca i8, align 1
  store i8 %1, ptr %b, align 1
  %a = alloca i8, align 1
  store i8 %0, ptr %a, align 1
  %a1 = load i8, ptr %a, align 1
  %b2 = load i8, ptr %b, align 1
  %right_shift = ashr i8 %a1, %b2
  store i8 %right_shift, ptr %a, align 1
